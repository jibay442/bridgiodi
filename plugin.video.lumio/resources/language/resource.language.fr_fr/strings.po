msgstr "Priorité 6"

msgctxt "#30087"
msgid "Priority 7"
msgstr "Priorité 7"

msgctxt "#30088"
msgid "Not used"
msgstr "Non utilisé"

msgctxt "#30089"
msgid "File size (biggest first)"
msgstr "Taille du fichier (le plus gros d'abord)"

msgctxt "#30090"
msgid "Resolution (4K > 1080p > 720p)"
msgstr "Résolution (4K > 1080p > 720p)"

msgctxt "#30091"
msgid "HDR (HDR10+ > HDR10)"
msgstr "HDR (HDR10+ > HDR10)"

msgctxt "#30092"
msgid "Dolby Vision"
msgstr "Dolby Vision"

msgctxt "#30093"
msgid "Audio channels (7.1 > 5.1 > 2.0)"
msgstr "Canaux audio (7.1 > 5.1 > 2.0)"

msgctxt "#30094"
msgid "Audio format (Atmos > TrueHD > DTS-HD > EAC3 > AC3)"
msgstr "Format audio (Atmos > TrueHD > DTS-HD > EAC3 > AC3)"

msgctxt "#30095"
msgid "Video codec (AV1 > HEVC > H.264)"
msgstr "Codec vidéo (AV1 > HEVC > H.264)"







