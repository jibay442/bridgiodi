msgctxt "#30000"
msgid "General"
msgstr "Général"

msgctxt "#30001"
msgid "Stremio manifest URL"
msgstr "URL du manifest Stremio"

msgctxt "#30002"
msgid "Debug logging"
msgstr "Journalisation de débogage"

msgctxt "#30003"
msgid "Write extra detail to the Kodi log (stream requests, sort priorities in use). Leave off for normal use."
msgstr "Écrit plus de détails dans le journal Kodi (requêtes de flux, priorités de tri utilisées). À laisser désactivé en usage normal."


msgctxt "#30020"
msgid "Filter"
msgstr "Filtre"

msgctxt "#30025"
msgid "Addon (Stremio)"
msgstr "Addon (Stremio)"

msgctxt "#30026"
msgid "Your personal Stremio manifest URL, ending in /manifest.json. Keep it private."
msgstr "L'URL de ton manifest Stremio personnel, terminant par /manifest.json. À garder confidentielle."

msgctxt "#30021"
msgid "Sort streams by quality (Dolby Vision / HDR / resolution first)"
msgstr "Trier les flux par qualité (Dolby Vision / HDR / résolution en premier)"

msgctxt "#30022"
msgid "Ranks streams so the best one (Dolby Vision, then HDR, then highest resolution) is always listed first."
msgstr "Classe les flux pour que le meilleur (Dolby Vision, puis HDR, puis la résolution la plus haute) soit toujours affiché en premier."

msgctxt "#30023"
msgid "Always play the best stream automatically"
msgstr "Toujours lire automatiquement le meilleur flux"

msgctxt "#30024"
msgid "Skips the stream selection list and plays the top-ranked stream directly. Requires quality sorting above to be meaningful."
msgstr "Ignore la liste de sélection des flux et lance directement le mieux classé. N'a de sens que si le tri par qualité ci-dessus est activé."

msgctxt "#30080"
msgid "Priority 1"
msgstr "Priorité 1"

msgctxt "#30081"
msgid "Streams are ranked by priority 1 first; equal streams are then split by priority 2, and so on. Leave a slot on \"Not used\" to ignore it."
msgstr "Les flux sont classés par la priorité 1 d'abord ; en cas d'égalité, la priorité 2 tranche, et ainsi de suite. Laisse un niveau sur « Non utilisé » pour l'ignorer."

msgctxt "#30082"
msgid "Priority 2"
msgstr "Priorité 2"

msgctxt "#30083"
msgid "Priority 3"
msgstr "Priorité 3"

msgctxt "#30084"
