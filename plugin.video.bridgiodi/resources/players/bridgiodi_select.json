{
	"name": "Bridgiodi (select source)",
	"plugin": "plugin.video.bridgiodi",
	"priority": 101,
	"is_resolvable": "true",
	"assert": {
		"play_movie": ["tmdb"],
		"play_episode": ["tmdb", "season", "episode"]
	},
	"play_movie": [
		"plugin://plugin.video.bridgiodi/?action=list_external&type=movie&tmdb={tmdb}&title={title_url}&year={year}",
		{"dialog": "true"}
	],
	"play_episode": [
		"plugin://plugin.video.bridgiodi/?action=list_external&type=episode&tmdb={tmdb}&season={season}&episode={episode}&showname={showname_url}&title={title_url}",
		{"dialog": "true"}
	]
}
